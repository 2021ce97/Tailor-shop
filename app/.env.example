# Required environment variables for local development and Vercel deployments
# For Supabase/Postgres, your DATABASE_URL may need ?sslmode=require at the end.
# Example (Supabase pooler):
# postgresql://postgres:password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgres://postgres:yourpassword@localhost:5432/tailor_shop"
SESSION_SECRET="generate-a-long-random-string-here"
